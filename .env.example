# Modelo local sem segredo. Copie para .env se precisar.
# Chaves reais de staging e produção ficam só no GitHub Environment homônimo.
# Este repositório não provisiona projeto Supabase.
APP_ENV=local
HTTP_BIND=127.0.0.1:8080
RUST_LOG=info
RUN_MIGRATIONS_ON_STARTUP=false
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FISCAL_MASTER_KEY_HEX=
SUPABASE_PROJECT_REF=local-project-unprovisioned
BACKUP_TARGET=local-backup-unprovisioned
LOG_SINK=local-logs-unprovisioned
ALERT_CHANNEL=local-alerts-unprovisioned
