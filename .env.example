# Ambiente local sem segredo. APP_ENV aceita local, staging ou production.
APP_ENV=local
HTTP_BIND=127.0.0.1:8080
RUST_LOG=info

# Precisa permanecer ausente ou false. O processo recusa iniciar se for true.
# RUN_MIGRATIONS_ON_STARTUP=false

# Opcional neste ticket. Se presente, fica só em memória e não entra em log.
# DATABASE_URL=
