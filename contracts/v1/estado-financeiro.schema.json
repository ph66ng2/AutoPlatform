{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoplatform.dev/contracts/v1/estado-financeiro.schema.json",
  "title": "EstadoFinanceiro",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_id",
    "correlation_id",
    "event_id",
    "idempotency_key",
    "fact_id",
    "state",
    "amount_cents",
    "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "company_id": { "type": "string", "format": "uuid" },
    "correlation_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "opaque-id"
    },
    "event_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "opaque-id"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "opaque-id"
    },
    "fact_id": { "type": "string", "format": "uuid" },
    "state": {
      "type": "string",
      "enum": ["pending", "received", "failed", "indeterminate"]
    },
    "amount_cents": { "type": "integer", "minimum": 0 },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
