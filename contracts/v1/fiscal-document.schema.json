{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoplatform.dev/contracts/v1/fiscal-document.schema.json",
  "title": "FiscalDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_id",
    "correlation_id",
    "event_id",
    "idempotency_key",
    "document_id",
    "kind",
    "status",
    "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "company_id": { "type": "string", "format": "uuid" },
    "correlation_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "opaque-id"
    },
    "event_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "opaque-id"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "opaque-id"
    },
    "document_id": { "type": "string", "format": "uuid" },
    "kind": { "type": "string", "enum": ["nfe", "nfse"] },
    "status": {
      "type": "string",
      "enum": ["draft", "issued", "cancelled", "indeterminate"]
    },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
